<script>
  const btn = document.getElementById('btn-verificar');
  const container = document.getElementById('respuestas-container');
  
  if (btn && container) {
    btn.addEventListener('click', () => {
      container.classList.toggle('hidden');
      if (container.classList.contains('hidden')) {
        btn.textContent = 'Verificar Respuestas';
        btn.classList.remove('bg-scientific-math', 'text-scientific-bg');
        btn.classList.add('bg-scientific-math/20', 'text-scientific-text');
      } else {
        btn.textContent = 'Ocultar Respuestas';
        btn.classList.remove('bg-scientific-math/20', 'text-scientific-text');
        btn.classList.add('bg-scientific-math', 'text-scientific-bg');
      }
    });
  }
</script>
